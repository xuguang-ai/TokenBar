# How Claude Code 2.1.289 (and 2.1.123) names the macOS Keychain generic-password item
# that stores the OAuth credential blob {claudeAiOauth:{accessToken,refreshToken,expiresAt,...}}.
# Derived from chunk-w8ydt51a.js (function x$ / mR / we / Nb). NO Keychain call was made.

import hashlib, unicodedata, os

def resolved_config_dir():
    # we(): CLAUDE_CONFIG_DIR if set, else ~/.claude; then NFC-normalized.
    d = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    return unicodedata.normalize("NFC", d)

def keychain_service_name(oauth_file_suffix=""):   # prod OAUTH_FILE_SUFFIX = ""
    base = "Claude Code" + oauth_file_suffix + "-credentials"
    securestore = os.environ.get("CLAUDE_SECURESTORAGE_CONFIG_DIR")  # usually unset
    if securestore is not None:
        use_base   = (securestore == "")            # empty string -> no hash
        hash_input = unicodedata.normalize("NFC", securestore)
    else:
        use_base   = (os.environ.get("CLAUDE_CONFIG_DIR") is None)  # unset -> default item
        hash_input = resolved_config_dir()
    if use_base:
        return base                                  # "Claude Code-credentials"
    h = hashlib.sha256(hash_input.encode("utf-8")).hexdigest()[:8]   # FIRST 8 hex chars
    return base + "-" + h                            # "Claude Code-credentials-xxxxxxxx"

def keychain_account():
    import re, pwd
    u = os.environ.get("USER") or pwd.getpwuid(os.getuid()).pw_name
    return u if re.match(r"^[a-zA-Z0-9._-]+$", u or "") else "claude-code-user"

# IMPORTANT: hash_input is the RAW env string, only NFC-normalized.
#   No realpath, no symlink resolution, trailing slash NOT stripped.
#   '/Users/x/.claude' and '/Users/x/.claude/' => DIFFERENT service names.

# Read it back (this is how CC reads it; same binary that created it, so no GUI prompt expected):
#   /usr/bin/security find-generic-password -a "<keychain_account()>" -w -s "<keychain_service_name()>"
#     -> stdout = the JSON credential blob
# (CC write form, for reference only - TokenBar must NEVER write:)
#   printf 'add-generic-password -U -a "<acct>" -s "<svc>" -X "<hexJSON>"\n' | /usr/bin/security -i

# Verified examples on this machine (USER=xai), computed offline (no Keychain access):
#   CLAUDE_CONFIG_DIR unset                      -> "Claude Code-credentials"
#   CLAUDE_CONFIG_DIR=/Users/xai/.claude         -> "Claude Code-credentials-4405f529"
#   CLAUDE_CONFIG_DIR=/Users/xai/.claude/  (slash)-> "Claude Code-credentials-338287a3"
#   CLAUDE_CONFIG_DIR=/Users/xai/.claude-work    -> "Claude Code-credentials-27c7d9a5"
#   CLAUDE_CONFIG_DIR=/Users/xai/.claude-personal would hash likewise.
# (Device keys use a separate service "Claude Code-device-keys" - not needed for usage.)
